PORT=4000
JWT_SECRET=change-me-in-production
DATABASE_URL="file:./dev.db"
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Web Push bildirimleri (opsiyonel) — boş bırakılırsa bildirimler sadece
# konsola loglanır. `npx web-push generate-vapid-keys` ile üretilir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Native (Capacitor/Android/iOS) push bildirimleri (opsiyonel) — Firebase
# projesinden indirilen servis hesabı JSON'unun tamamı, tek satır olarak.
# Boş bırakılırsa native push sadece konsola loglanır.
FIREBASE_SERVICE_ACCOUNT_JSON=
